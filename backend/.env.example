# Server Port
PORT=8000

# Database URL (SQLite default, can be set to PostgreSQL)
DATABASE_URL=sqlite:///./civicfix.db
# DATABASE_URL=postgresql://user:password@localhost:5432/civicfix

# Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# AI Vision & VLM Keys (Optional, fallback provided if omitted)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=your_openai_api_key_here

# Admin Authorization Key (Optional for dev, recommended for prod)
ADMIN_API_KEY=your_admin_secret_key_here

# Persistent Cloud Storage (Optional for dev, recommended for prod ephemeral hosts)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
